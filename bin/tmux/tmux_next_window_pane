#!/usr/bin/env bash
readonly ARG1="$1"
win_zoomed() {
  if [[ $(tmux display-message -p '#{window_zoomed_flag}') == "1" ]]; then
    return 0
  else
    return 1
  fi
}

reverse_if_needed() {
  if [[ "${ARG1}" == "--reverse" ]]; then
    echo "$1"| tail -r
  else
    echo "$1"
  fi
}

select_next_win() {
  w_list=$(tmux list-windows -F '#{window_index},active=#{window_active}')
  w_list=$(echo "${w_list}"; echo "${w_list}")
  w_list=$(reverse_if_needed "${w_list}")
  w_idx=$(echo "${w_list}"| grep -A 1 "active=1"| awk -F',' 'NR==2 {print $1}')
  tmux select-window -t "${w_idx}"
}

select_next_pane() {
  p_list=$(tmux list-panes -F '#{pane_index},active=#{pane_active}')
  p_list=$(reverse_if_needed "${p_list}")
  p_idx=$(echo "${p_list}"| grep -A 1 "active=1"| awk -F',' 'NR==2 {print $1}')
  if [[ -z "${p_idx}" ]]; then
    return 1
  fi
  tmux select-pane -t "${p_idx}"
}

select_first_pane() {
  p_list=$(tmux list-panes -F '#{pane_index}')
  p_list=$(reverse_if_needed "${p_list}")
  p_idx=$(echo "${p_list}"| awk -F',' 'NR==1 {print $1}')
  tmux select-pane -t "${p_idx}"
}

move_to_next_win() {
  select_next_win
  win_zoomed || select_first_pane
}

if win_zoomed; then
  move_to_next_win
else
  select_next_pane || move_to_next_win
fi
