#!/usr/bin/env bash

#   usage: tmux_battery [client_width]
#
# pmset は 1 回あたり数十 ms かかるため、status-interval 1 で毎秒叩かないよう
# statistics/battery_info の結果を tmux_cache 経由で受け取る。
# 充電マークの点滅だけは毎秒動かしたいので、キャッシュを挟まずここで組み立てる。
#
# 毎秒通る経路なので fork を増やさないこと (1 プロセスあたり 10ms 前後かかる)。
# client_width は conf 側から #{client_width} を渡してもらう。省略時だけ
# tmux_client_width にフォールバックする。

set -u

readonly bin_dir="$HOME/dotfiles/bin/tmux"
readonly cache_ttl=10

width=${1:-}
[[ ${width} =~ ^[0-9]+$ ]] || width=$("${bin_dir}/tmux_client_width")

# discharging / percent / wattage / remaining をタブ区切りで受け取る。
IFS=$'\t' read -r discharging percent wattage remaining < <(
  "${bin_dir}/tmux_cache" "${cache_ttl}" battery_info "${bin_dir}/statistics/battery_info"
)

# 秒の偶奇で点滅させる。date を呼ばずに済むよう EPOCHSECONDS を使う。
if (( EPOCHSECONDS % 2 == 1 )); then
  mark=" "
elif [[ ${discharging} -eq 1 ]]; then
  mark="~"
else
  mark="+"
fi

if (( width > 160 )); then
  printf "%s%2d%%(%sW,%s)" "${mark}" "${percent}" "${wattage}" "${remaining}"
else
  printf "%s%2d%%(%sW)" "${mark}" "${percent}" "${wattage}"
fi
