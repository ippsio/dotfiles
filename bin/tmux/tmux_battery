#!/usr/bin/env bash
is_discharging() {
  if type "pmset" &>/dev/null && pmset -g ps | grep -E "discharging" >/dev/null 2>&1; then
    return 0
  else
    return 1
  fi
}

percent() {
  pmset -g ps | grep -o '[0-9]\+%' | tr -d '%'
}
wattage() {
  pmset -g ac| grep -F "Wattage"| grep -o '[0-9]\+'
}

remaining() {
  local res="$(pmset -g ps | grep -o '[0-9]\+:[0-9]\+')"
  if [[ -z "$res" ]]; then
    res="--:--"
  fi
  echo "$res"
}
charging_mark() {
  second=$(date +'%S')
  odd_or_even=$(( second % 2 ))
  if is_discharging; then
    if [[ $odd_or_even -eq 1 ]]; then
      echo " "
    else
      echo "~"
    fi
  else
    if [[ $odd_or_even -eq 1 ]]; then
      echo " "
    else
      echo "+"
    fi
  fi
}

get_status() {
  charging_mark="$(charging_mark)"
  charging_mark="${charging_mark:- }"
  percent="$(percent)"
  wattage="$(wattage)"
  wattage="${wattage:---}"
  remaining="$(remaining)"
  width=$(~/dotfiles/bin/tmux/tmux_client_width)

  if [[ $width -gt 160 ]]; then
    printf "%s%2d%%(%sW,%s)" "$charging_mark" "$percent" "$wattage" "$remaining"
  else
    printf "%s%2d%%(%sW)" "$charging_mark" "$percent" "$wattage"
  fi
}

get_status
