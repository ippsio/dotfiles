#!/usr/bin/env bash
PWD=$(echo "$1"| ~/dotfiles/bin/swiss_army_knife/home_as_tilde)
setting=$(cat <<EOF
~/dotfiles#bg=colour18
~/review#fg=colour206,bg=colour54
EOF
)

pane_number_current=$(tmux_pane_number_current)
window_active_style_was=$(tmux show-options -v -t "${pane_number_current}" window-active-style| grep -Ev "^$"| awk '{ if (NR==1) { printf "%s", $0 } else { printf ", %s", $0 }}; END { printf "\n" }')
(
  window_active_style="fg=default,bg=default"
  IFS=$'\n'
  for row in $(echo "$setting"); do
    path_regx=$(echo "$row"| awk -F'#' '{ print $1 }')
    if ( echo "$PWD"| grep -E "$path_regx">/dev/null 2>&1 ); then
      window_active_style=$(echo "$row"| awk -F'#' '{ print $2 }')
      break
    fi
  done
  if [[ "${window_active_style}" != "${window_active_style_was}" ]]; then
    eval "set -x; tmux set window-active-style \"$window_active_style\""
  fi
)
