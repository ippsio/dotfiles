#!/usr/bin/env bash
pane_style_was=$(tmux select-pane -g)
f="${1:-240}"
t="${2:-240}"
for i in $( ( seq "${f}" "${t}"; seq "${t}" "${f}" ) | awk 'prev != $0 { print } { prev = $0 }' ); do
  eval "tmux select-pane -P bg=colour${i}"
  sleep "${3:-0.03}"
done
eval "tmux select-pane -P ${pane_style_was}"
tmux display-panes -d 250
