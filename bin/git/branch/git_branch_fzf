#!/usr/bin/env bash
# home_as_tilde "$0"| xargs -I {} echo "'{}' called"  1>&2

COMMIT_LOG_ROWS=15
if ! is_git_repo; then
  echo "Not a git repository."
  exit 1
fi
basename0=$(basename "$0")
get_branches() {
  res=$(git branch --all --sort=-authordate --color=always --format='%(objectname:short)	%(authordate:format:%Y-%m-%d %H:%M:%S(%a))	%(authorname)	%(refname:short)	%(subject)')
  echo "$res"| grep -E '	(develop|origin/develop)	'
  echo "$res"| grep -E '	(master|origin/master)	'
  echo "$res"| grep -Ev '	(HEAD|origin/HEAD|develop|origin/develop|master|origin/master)	'
}
do_awk() {
  awk -F '	' '{
    h[NR] = $1
    ad[NR] = $2
    an[NR] = $3
    branch[NR] = $4
    s[NR] = $5
    if (length($4) > branch_w) branch_w = length($4)
  }
  END {
    fmt = "(%+3s)	%-" branch_w "s	%s	%s	%-8.8s	%s \n"
    for (i = 1; i <= NR; i++) printf fmt, i, branch[i], h[i], ad[i], an[i], s[i]
  }'
}
do_fzf() {
  bind_tab() {
    printf '%s\n' "cd '$(git_root)'|| exit 1"
    printf '%s\n' "git_log_fzf {2}"
  }
  fzf \
    --ansi \
    --prompt="$basename0 > " \
    --no-sort \
    --info=inline \
    --tabstop=3 \
    --delimiter="	" \
    --nth=2,5 \
    --bind "tab:execute($(bind_tab))" \
    --bind "ctrl-l:execute(cd $(git_root); git_log_fzf {2})"
  }
get_branches\
  | do_awk\
  | do_fzf\
  | awk -F '	' '{ sub(/ +$/, "", $2); sub(/^origin\//, "", $2); print $2 }'
