#!/bin/bash
if [[ -n "${HUB_TOKEN}" ]]; then
  printf "%s" "${HUB_TOKEN}"
  exit
fi

if [[ -e ~/.config/hub ]]; then
  config_hub_outh_token=$(cat ~/.config/hub| grep "oauth_token:"| awk '{ print $2 }' 2>/dev/null)
  if [[ -n "${config_hub_outh_token}" ]]; then
    printf "%s" "${config_hub_outh_token}"
    exit
  fi
fi

