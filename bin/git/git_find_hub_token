#!/usr/bin/env bash
dot_confit_hub_exist() {
  if [[ -e ~/.config/hub ]]; then
    return 0
  else
    return 1
  fi
}
get_dot_config_hub_oauth_token() {
  cat ~/.config/hub| grep "oauth_token:"| awk '{ print $2 }' 2>/dev/null
}
hub_token_exists() {
  if [[ -n "${HUB_TOKEN}" ]]; then
    return 0
  else
    return 1
  fi
}
get_hub_token() {
  printf "%s" "${HUB_TOKEN}"
}
if hub_token_exists; then
  get_hub_token

elif dot_confit_hub_exist; then
  get_dot_config_hub_oauth_token
fi
