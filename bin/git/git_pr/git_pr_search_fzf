#!/usr/bin/env bash

commit=$1
basename0=$(basename "$0")
fzf_prompt="$basename0 commit='${commit}' > "
fzf_header="enter:neovim, tab:open browser"
fzf_preview="
echo '# commit: '${commit}' に関するpull request です。';
echo '\033[48;5;27m- Author: ['{3}']\033[0m';
echo '\033[48;5;27m- Title: ['{4}']\033[0m';
echo '- No: ['{1}']  State: ['{2}'] Merged_at: ['{10}']';
echo '- Created_at: ['{7}']  Updated_at: ['{8}']  Closed_at:  ['{9}']';
echo '---------------------------------------------------';
echo {5};
"

if is_git_hash "$1"; then
  res=$(git_pr_search_with_hash "${commit}")
elif is_git_branch "$1"; then
  res=$(git_pr_search_with_branch "${commit}")
else
  res=$(git_pr_search_with_author "${commit}")
fi

if [[ -z ${res} ]]; then
  exit 0
fi

echo "${res}"| fzf --delimiter="	" --nth=1..3 --no-sort --prompt="${fzf_prompt}" --header="${fzf_header}" --delimiter='\t' \
  --bind "enter:execute(($fzf_preview)| strip_color| sed -e 's/\r//g'| nvim -Ro -c \"set ft=markdown\" > /dev/tty)" \
  --bind "tab:execute(open '{6}')" \
  --preview="${fzf_preview}" \
  --preview-window=down,75%
