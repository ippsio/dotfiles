#!/usr/bin/env bash

url="https://api.github.com/search/issues?q=is:open%20type:pr%20repo:$(git_reponame)%20author:$1"
res=$(github_send_get_request "${url}"| jq -r ".items[] | [ \
  .number \
  ,.state \
  ,.user.login \
  ,.title \
  ,.body \
  ,.html_url \
  ,.created_at \
  ,.updated_at \
  ,.closed_at \
  ] | @tsv"
)

if [[ -z "${res}" ]]; then
  echo "GIT_SEARCH_PR:PR_NOT_FOUND"
  exit 1
fi

echo "${res}"
