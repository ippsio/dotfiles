#!/usr/bin/env bash
h1="$1"
h2_3dots="...$2"
h2_two_dots="..${2:-HEAD}"
git_log=$(escape_SQ "git log -1 --oneline --abbrev-commit --decorate=full --date=format-local:'%Y/%m/%d %H:%M:%S' --pretty=format:'%h	(%cd)	%an	%d	%s' ${h1}${h2_two_dots} -- {3}")
git_diff_colored="git diff --color=always ${h1}${h2_3dots} -- {3}"
if type "diff-highlight" > /dev/null 2>&1; then
  git_diff_colored="${git_diff_colored}| diff-highlight"
fi
git_diff_numstat="(set -x; git diff --diff-filter=ACDMR --numstat ${h1}${h2_3dots})"
files=$(eval "${git_diff_numstat}" | awk '
  {
    printf "%2s", NR; printf "	"; printf "%+4s", "+" $1; printf "|"; printf "%-4s", $2 "-"; printf "	";
    if (index($0, "=>") == 0) {
      printf "%s\n", $3
    } else {
      printf "%s %s %s\n", $3,$4,$5;
    }
  }')
fzf_preview="
cd $(git_root);
echo -n {1};
echo -n '	';
echo {2} | awk -F '|' '{ printf \"%s|%s\", \$1, \$2 }';
echo -n '	';
echo {3};

echo '${git_log}';
eval '${git_log}'| awk -F '\t' '{ printf \"%2s	%s\n\", NR, \$0; }'
horizontal_line;
echo;

echo '${git_diff_colored}';
echo;
eval '${git_diff_colored}';"
cr="
"
(
  export GIT_MERGE_BASE=${h1};
  git_root_dir=$(set -x; git_root)
  cd "${git_root_dir}"|| exit;
  echo "$files"| fzf --tabstop=1 --ansi --info=inline --nth=1,3 \
    --prompt="$(printf '%s %s %s > ' \"$(basename $0)\" \"$1\" \"$2\")" \
    --header="${git_diff_numstat}${cr} (enter: nvim)  (tab: tig) (ctrl-l: git_log_fzf)   (ctrl-/: preview toggle)" \
    --bind="ctrl-v:execute(nvim {3} >/dev/tty)" \
    --bind="tab:execute(tig ${h1}${h2_3dots} -- {3} </dev/tty >/dev/tty)" \
    --bind="enter:execute((set -x; git difftool ${h1} -- {3} </dev/tty >/dev/tty))+clear-query" \
    --bind="ctrl-l:execute(git_log_fzf \"${h1}${h2_two_dots}\" \"{3}\")" \
    --bind='ctrl-/:toggle-preview' \
    --preview-window=bottom:75% \
    --preview="$fzf_preview"
)| awk '{print $3}'
