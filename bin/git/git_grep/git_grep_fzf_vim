#!/usr/bin/env bash

AWK_CMD="awk 'BEGIN { count=0 } { files[NR]=\$0; count++ } END { for (i=1; i<=count; i++) { printf \"(%d/%d:git-grep)	%s\n\", i, count, files[i] } }'"
GIT_GREP_CMD="git -c grep.fallbackToNoIndex=true grep -I --line-number --fixed-strings"
GIT_GREP_CMD_START="${GIT_GREP_CMD} --null --color=always $1| perl -pe 's/\x0/\t/g'| ${AWK_CMD}"

eval "${GIT_GREP_CMD_START}"| fzf \
  -m --print-query --info=inline --ansi --delimiter='\t' --tabstop=2\
  --bind "start:reload:$GIT_GREP_CMD_START"\
  --bind "ctrl-/:toggle-preview" \
  --bind "ctrl-_:toggle-preview" \
  --bind "ctrl-b:page-up" \
  --bind "ctrl-c:print-query" \
  --bind "ctrl-f:page-down" \
  --bind "ctrl-p:execute(git_pull_request_open_by_file_line {2} {3})" \
  --bind "tab:execute(git_pull_request_show_by_file_line {2} {3})" \
  --bind="enter:execute(nvim {2} +{3} < /dev/tty > /dev/tty)" \
  --preview-window"=right:70%"\
  --preview="git_blame_colored {2} {3} {q}"
echo "---"
echo "GIT_GREP_CMD=$GIT_GREP_CMD \"$1\""
