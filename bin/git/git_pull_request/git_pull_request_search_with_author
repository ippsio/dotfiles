#!/usr/bin/env bash

SPACE="%20"
HTTP_URL="https://api.github.com/search/issues?q=is:open${SPACE}type:pr${SPACE}repo:$(git_reponame)${SPACE}author:$1"
res=$(github_send_get_request "${HTTP_URL}")
res=$(echo "$res"| jq -r ".items[] \
  | [ \
    .number \
    ,.state \
    ,.user.login \
    ,.title \
    ,.body \
    ,.html_url \
    ,.created_at \
    ,.updated_at \
    ,.closed_at \
  ] | @tsv")

if [[ -z "${res}" ]]; then
  echo "GIT_SEARCH_PR:PR_NOT_FOUND"
  exit 1
fi

echo "${res}"

