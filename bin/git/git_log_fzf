#!/usr/bin/env bash
range=$1
file=$2
basename0=$(basename "$0")
do_git_log() {
  if [[ -n "$file" ]]; then
    git --no-pager log --oneline --date=format-local:"%Y/%m/%d %H:%M(%a)" --pretty=format:"%h	%ad	%an	%s" "$range" -- "$file"
  else
    git --no-pager log --oneline --date=format-local:"%Y/%m/%d %H:%M(%a)" --pretty=format:"%h	%ad	%an	%s" "$range"
  fi
}
do_fzf() {
  get_fzf_prompt() {
    printf "\$0=%s, \$1=[%s], \$2=[%s] > " "$basename0" "$range" "$file"
  }
  get_fzf_header() {
    printf " (enter: git diff) (ctrl-p: PR) (ctrl-y: yank hash)"
  }
  get_fzf_preview() {
    preview=$(printf "git log -1 --color=always -p --stat --pretty=fuller --abbrev-commit {2} %s" "$file")
    if type "diff-highlight">/dev/null 2>&1; then
      preview=$(printf "%s| diff-highlight" "$preview")
    fi
    printf '%s\n' "echo '$preview'"
    printf '%s\n' "echo '---'"
    printf '%s\n' "$preview| tail -n +2"
  }
  get_fzf_tab_cmd() {
    printf 'git log -1 -p {2} %s < /dev/tty > /dev/tty' "$file"
  }
  get_fzf_enter_cmd() {
    printf 'git log -1 -p --stat --pretty=fuller --abbrev-commit {2} %s' "$file"
    printf '  | nvim -R -c "set ft=diff nomod nolist nospell nu"> /dev/tty'
  }
  fzf \
    --ansi \
    --info=inline \
    --prompt="$(get_fzf_prompt)" \
    --no-clear \
    --tabstop=1 \
    --header="$(get_fzf_header)" \
    --no-sort \
    --delimiter='\t' \
    --bind "enter:execute($(get_fzf_enter_cmd))" \
    --bind "tab:execute($(get_fzf_tab_cmd))" \
    --bind "j:down" \
    --bind "k:up" \
    --bind "ctrl-y:execute(echo -n {2}| pbcopy)" \
    --bind "ctrl-/:toggle-preview" \
    --bind "ctrl-_:toggle-preview" \
    --bind "ctrl-p:execute:(git_pr_search_fzf {2})" \
    --preview="$(get_fzf_preview)" \
    --preview-window=bottom:85%
}
do_git_log| awk -F '	' '{ printf "%+2s	%s\n", NR, $0 }' | do_fzf
