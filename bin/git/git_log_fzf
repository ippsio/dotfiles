#!/usr/bin/env bash
range=$1
file=$2
basename0=$(basename "$0")
get_fzf_prompt() {
  printf "%s (range=[%s],file=[%s]) > " "$basename0" "$range" "$file"
}
get_fzf_header() {
  printf " (enter: git diff) (ctrl-p: PR) (ctrl-y: yank hash)"
}
do_git_log() {
  git --no-pager log \
    --graph \
    --author-date-order \
    --oneline \
    --full-history \
    --decorate=full \
    --abbrev-commit \
    --color=always \
    --date=format-local:"%Y/%m/%d %H:%M(%a)" \
    --pretty=format:"	%an	%s	%h	%cd	%d" "$range" -- "$file"
}
get_diff_merges() {
  printf '%s' '--diff-merges=first-parent'
}
get_git_log_1p_cmd() {
  if type "diff-highlight">/dev/null 2>&1; then
    printf "git log -1 --color=always %s -p --stat --pretty=fuller --abbrev-commit {2} %s| diff-highlight" "$(get_diff_merges)" "$file"
  else
    printf "git log -1 --color=always %s -p --stat --pretty=fuller --abbrev-commit {2} %s" "$(get_diff_merges)" "$file"
  fi
}
get_fzf_preview() {
  printf '%s\n' "echo '$(get_git_log_1p_cmd)'"
  printf '%s\n' "echo '---'"
  printf '%s\n' "$(get_git_log_1p_cmd)| tail -n +2"
}
get_enter_cmd() {
  printf 'git log -1 %s -p --stat --pretty=fuller --abbrev-commit {2} %s' "$(get_diff_merges)" "$file"
  printf '  | nvim -R -c "set ft=diff nomod nolist nospell nu"> /dev/tty'
}
get_bind_tab_cmd() {
  printf 'git log -1 -p {2} %s < /dev/tty > /dev/tty' "$file"
}
do_fzf() {
  fzf \
    --ansi \
    --info=inline \
    --prompt="$(get_fzf_prompt)" \
    --no-clear \
    --tabstop=1 \
    --header="$(get_fzf_header)" \
    --no-sort \
    --delimiter='\t' \
    --bind "enter:execute($(get_enter_cmd))" \
    --bind "tab:execute($(get_bind_tab_cmd))" \
    --bind "ctrl-y:execute(echo -n {2}| pbcopy)" \
    --bind "ctrl-/:toggle-preview" \
    --bind "ctrl-_:toggle-preview" \
    --bind "ctrl-p:execute:(git_pr_search_fzf {2})" \
    --preview="$(get_fzf_preview)" \
    --preview-window=bottom:85%
}
do_awk() {
  awk -F '	' '{ printf "%+2s	%s	%s	%s	%s	%s	%s\n", NR, $4, $5, $2, $1, $6, $3 }'
}
do_git_log| grep --fixed-strings '*' | do_awk | do_fzf
