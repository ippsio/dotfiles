#!/usr/bin/env bash
# home_as_tilde "$0"| xargs -I {} echo "'{}' called"  1>&2

COMMIT_LOG_ROWS=15
if ! is_git_repo; then
  echo "Not a git repository."
  exit 1
fi
basename0=$(basename "$0")
get_branches() {
  git log --oneline -1| awk '{ gsub(/[0-9a-f]/, "o", $1); print $1 }'
  echo "oooo-oo-oo	oo:oo:oo(oo)	ooooooooooooooooooo	-- 	現在の変更を取り消す。"
  res=$(git branch --all --sort=-authordate --color=always --format='%(objectname:short)	%(authordate:format:%Y-%m-%d	%H:%M:%S(%a))	%(authorname)	%(refname:short)	%(subject)')
  echo "$res"| grep -E '	(develop|origin/develop)	'
  echo "$res"| grep -E '	(master|origin/master)	'
  echo "$res"| grep -Ev '	(HEAD|origin/HEAD|develop|origin/develop|master|origin/master)	'
}
do_awk() {
  awk -F '	' -v v_line_cnt="$1" '{
    if (index($5, "origin/") > 0) {
      btype = "origin"
      bname = substr($5, length("origin/") + 1)
    } else {
      btype = " local"
      bname = $5
    }
    printf "(%+2s/%s)	%s	%s	%-35s	%s	%s	%s\n", NR, v_line_cnt, $1, $3, $4, btype, bname, $6;
  }'
}
do_fzf() {
  get_git_log_cmd() {
    echo "git log --oneline --abbrev-commit --decorate=full --date=format-local:'%Y/%m/%d %H:%M:%S' --pretty=format:'%h	(%ad)	%an	%d	%s'"
  }
  git_log_cmd=$(get_git_log_cmd)
  get_fzf_preview() {
    printf '%s\n' "cd $(git_root)|| exit 1"
    printf '%s\n' "if [[ {5} == 'origin' ]]; then"
    printf '%s\n' "  echo \"$git_log_cmd\" {5}/{6}"
    printf '%s\n' "  $git_log_cmd {5}/{6}"
    printf '%s\n' "else"
    printf '%s\n' "  echo \"$git_log_cmd\" {6}"
    printf '%s\n' "  $git_log_cmd {6}"
    printf '%s\n' "fi"
  }
  bind_tab() {
    printf '%s\n' "cd '$(git_root)'|| exit 1"
    printf '%s\n' "if [[ {5} == 'origin' ]]; then"
    printf '%s\n' "  git_log_fzf origin/{6}"
    printf '%s\n' "else"
    printf '%s\n' "  git_log_fzf {6}"
    printf '%s\n' "fi"
  }
  fzf \
    --ansi \
    --prompt="$basename0 > " \
    --no-sort \
    --info=inline \
    --tabstop=1 \
    --delimiter="	" \
    --nth=1,4,5,6,7 \
    --bind "tab:execute($(bind_tab))" \
    --bind "ctrl-l:execute(cd $(git_root); git_log_fzf {7})" \
    --preview-window down,15 \
    --preview="$(get_fzf_preview)"
  }
lines=$(get_branches)
line_cnt=$(echo "$lines"| chop_blank_line| wc -l| tr -d ' ')
echo "$lines"\
  | do_awk "$line_cnt"\
  | do_fzf\
  | awk -F '	' '{ print $6 }'
