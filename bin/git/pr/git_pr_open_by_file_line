#!/usr/bin/env bash
file=$1
line=$2
get_pr_no() {
  commit_hash=$(git blame -L "${line},${line}" "${file}"| awk '{ print $1 }')
  git_pr_no_by_hash "${commit_hash}"| sed -E 's/[[:blank:]]*//'| sed -E 's/#//'
}

pr_no=$(get_pr_no)
if [[ -n "${pr_no}" ]]; then
  open "https://github.com/$(git_reponame)/pull/${pr_no}"
else
  echo "No PR found."
fi
