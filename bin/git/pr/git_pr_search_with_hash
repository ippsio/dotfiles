#!/usr/bin/env bash
if ! (is_git_hash "$1"); then
  echo "GIT_SEARCH_PR:PR_NOT_FOUND"
  exit 1
fi

url="https://api.github.com/search/issues?q=type:pr%20repo:$(git_reponame)%20$1"
res=$(github_send_get_request "$url"| jq -r ".items[] | [ \
  .number \
  , .state \
  , .user.login \
  , .title \
  , .body \
  , .html_url \
  , .created_at \
  , .updated_at \
  , .closed_at \
  , .merged_at \
  ] | @tsv"
)

if [[ -z "${res}" ]]; then
  echo "GIT_SEARCH_PR:PR_NOT_FOUND"
  exit 1
fi

echo "${res}"

