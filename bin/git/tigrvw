#!/usr/bin/env bash
home_as_tilde "$0"| xargs -I {} echo "'{}' called"  1>&2

source git_review_core "$@"
{
  echo "${review_json}";
  echo "---";
  GIT_DIFF_CMD="git diff -w --stat=200 --stat-name-width=160 -p ${merge_base_hash}"
  echo "${GIT_DIFF_CMD}"
  eval "${GIT_DIFF_CMD}"
}| {
  set -x
  export GIT_MERGE_BASE=${merge_base_hash}
  tig show "${merge_base_hash}"...HEAD
}
