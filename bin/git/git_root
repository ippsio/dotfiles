#!/usr/bin/env bash
if [[ -n $1 ]]; then
  if [[ -f $1 ]]; then
    dir=$(dirname "$1")
    cd "${dir}" && git rev-parse --show-superproject-working-tree --show-toplevel 2>&1| head -1 || exit 1
  elif [[ -d $1 ]]; then
    cd "$1" && git rev-parse --show-superproject-working-tree --show-toplevel 2>&1| head -1 || exit 1
  fi
else
  git rev-parse --show-superproject-working-tree --show-toplevel 2>&1| head -1
fi
