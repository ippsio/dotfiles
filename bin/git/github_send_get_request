#!/usr/bin/env bash
# GitHub REST API への GET を gh CLI 経由で行う。
# 認証はすべて gh に委譲する:
#   - 通常はログイン済みアカウント(キーリング)を使用
#   - direnv 等で GH_TOKEN / GITHUB_TOKEN が設定されていればそちらを優先(org別切替に使える)
readonly URL=$1

if ! command -v gh >/dev/null 2>&1; then
  echo "gh command not found" 1>&2
  exit 114 # FAILED TO GET TOKEN (gh 未導入/未認証)
fi

# gh api はベースURL相対のパスを取るので https://api.github.com/ を剥がす。
# 例: https://api.github.com/search/issues?q=... -> search/issues?q=...
#     https://api.github.com/repos/OWNER/REPO/pulls/1 -> repos/OWNER/REPO/pulls/1
api_path="${URL#https://api.github.com/}"

gh api -H "X-GitHub-Api-Version: 2022-11-28" "${api_path}"
exitcd="$?"
if [[ "$exitcd" != "0" ]]; then
  echo "gh api returns exitcd $exitcd" 1>&2
  exit 115 # CURL FAILED (gh api 失敗も同じハンドラで扱う)
fi
