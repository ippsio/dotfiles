#!/usr/bin/env bash

# git grep earch + fzf filter +  edit with vim .
AWK_CMD="awk 'BEGIN { count=0 } { files[NR]=\$0; count++ } END { for (i=1; i<=count; i++) { printf \"(%d/%d:git-grep)	%s\n\", i, count, files[i] } }'"
GIT_GREP_CMD="git -c grep.fallbackToNoIndex=true grep -I --null --line-number --color=always --fixed-strings"
GIT_GREP_CMD_START="${GIT_GREP_CMD} $1| perl -pe 's/\x0/\t/g'| ${AWK_CMD}"
GIT_GREP_CMD_CHANGE="${GIT_GREP_CMD} {q}| perl -pe 's/\x0/\t/g'| ${AWK_CMD}"

fzf -m --query="$1" --info=inline --ansi --delimiter='	' --tabstop=2\
      --bind "start:reload:$GIT_GREP_CMD_START"\
      --bind "change:reload:sleep 0.1; $GIT_GREP_CMD_CHANGE || true"\
      --preview-window"=wrap:bottom:65%"\
      --preview="git_blame_colored {2} {3} {q}"

