#!/usr/bin/env bash
home_as_tilde "$0"| xargs -I {} echo "'{}' called"  1>&2

current_branch=$(git_branch_current)
branch=${1:-${current_branch}}
if ! ( is_git_branch "${branch}"); then
  exit 111 # INVALID_GIT_BRANCH_GIVEN
fi
SPACE="%20"
API_RES=$(github_send_get_request "https://api.github.com/search/issues?q=is:open${SPACE}type:pr${SPACE}repo:$(git_reponame)${SPACE}head:${branch}")|| exit $?
RES=$(echo "$API_RES"| jq -r ".items[] | [ .number, .state, .user.login, .title, .body, .html_url, .created_at, .updated_at, .closed_at ] | @tsv" 2>/dev/null)

if [[ -n "${RES}" ]]; then
  # 1 number, 2 state, 3 user.login, 4 title, 5 body, 6 html_url, 7 created_at, 8 updated_at, 9 closed_at
  echo "${RES}"
  exit 0
else
  echo "GIT_SEARCH_PR:PR_NOT_FOUND" 1>&2
fi

