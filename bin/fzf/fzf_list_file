#!/usr/bin/env bash
get_list() {
  # max-depth=6の数字6の根拠は特になし。適当。
  rg --files --max-depth=6 --hidden --no-ignore --glob '!.git' --glob '!.git/*' --sort=path "$1" 2>/dev/null| sed 's#^./##g'| home_as_tilde| sort
}
make_fzf_preview() {
  printf '%s\n' "f_hah=\"\$(home_as_home {})\""
  printf '%s\n' "h_abs=\"\$(home_as_home {}| xargs realpath)\""
  printf '%s\n' "if is_binary \"\$h_abs\"; then"
  printf '%s\n' "  home_as_tilde \"\$h_abs\""
  printf '%s\n' "  echo"
  printf '%s\n' "  echo \"<<<BINARY FILE>>>\""
  printf '%s\n' "  { set -x; exiftool -s -t \"\$h_abs\" }| column -s$'\t' -t| awk '{ printf \"%2d %s\n\", NR, \$0 }'"
  printf '%s\n' "  echo \"---\""
  printf '%s\n' "  { set -x; bat --show-all --nonprintable-notation caret \"\$h_abs\"}"
  printf '%s\n' "else"
  printf '%s\n' "  is_git_repo=\$(cd \$(dirname \"\$h_abs\"); git rev-parse --is-inside-work-tree 2> /dev/null)"
  printf '%s\n' "  if [[ \"\$is_git_repo\" == \"true\" ]]; then"
  printf '%s\n' "    git_blame_colored \"\$h_abs\""
  printf '%s\n' "  else"
  printf '%s\n' "    { set -x; bat \"\$f_hah\" --color=always --style=numbers --line-range :100 }"
  printf '%s\n' "  fi"
  printf '%s\n' "fi"
}
apply_fzf() {
  get_list "$1"| fzf +m\
    --no-sort \
    --query="$3 "\
    --disabled \
    --header="ctrl+'g':ripgrep, ctrl+'-':TogglePreview"\
    --prompt="$4"\
    --info=inline\
    --bind 'a:ignore' --bind 'b:ignore' --bind 'c:ignore'\
    --bind 'd:ignore' --bind 'e:ignore' --bind 'f:ignore'\
    --bind 'g:ignore' --bind 'h:ignore'\
    --bind 'i:enable-search+unbind(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z)'\
    --bind 'j:Down' --bind 'k:Up'\
    --bind 'l:ignore' --bind 'm:ignore' --bind 'n:ignore'\
    --bind 'o:ignore' --bind 'p:ignore'\
    --bind 'q:abort'\
    --bind 'r:ignore' --bind 's:ignore' --bind 't:ignore'\
    --bind 'u:ignore' --bind 'v:ignore' --bind 'w:ignore'\
    --bind 'x:ignore' --bind 'y:ignore' --bind 'z:ignore'\
    --bind 'esc:enable-search+unbind(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z)'\
    --bind "ctrl-_:toggle-preview" \
    --bind "ctrl-g:execute(rg_fzf_vim . $1 < /dev/tty > /dev/tty)" \
    --preview-window=right:60%:wrap\
    --preview="$5"
}

dir=$(dirname "$0")
source "${dir}/func/fzf_list_functions.sh"
basename0=$(basename "$0")
target_dir_h_as_h=$(get_target_dir_h_as_h "$1")
target_dir_h_as_t=$(home_as_tilde "$target_dir_h_as_h")
fzf_prompt=$(printf "%s (dir='%s')" "$basename0" "$target_dir_h_as_t")
fzf_query=$(get_fzf_query "$1")
fzf_preview=$(make_fzf_preview)
res=$(apply_fzf "$target_dir_h_as_h" "$target_dir_h_as_t" "$fzf_query" "$fzf_prompt" "$fzf_preview"|| printf "%s" "$1")
echo "$res" | awk '{ if (NF >= 2) { printf "\"%s\"", $0 } else { printf "%s", $0 } }'
