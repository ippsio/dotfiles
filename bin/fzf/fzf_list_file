#!/usr/bin/env bash
get_list() {
  fd --hidden --no-ignore --exclude .git --type f . "$1" | sed 's#^./##g' | home_as_tilde | sort
}
apply_fzf() {
  get_list "$1"| fzf +m\
    --style=minimal \
    --ansi \
    --no-sort \
    --query="$3 "\
    --header="ctrl+'g':ripgrep, ctrl+'-':TogglePreview"\
    --prompt="$4"\
    --info=inline\
    --bind "ctrl-_:toggle-preview" \
    --bind "ctrl-g:execute(rg_fzf_vim . $1 < /dev/tty > /dev/tty)" \
    --preview-window=right:60%:wrap\
    --preview="$5"
}

dir=$(dirname "$0")
source "$dir/func/fzf_list_functions.sh"
target_dir_h_as_h=$(get_target_dir_h_as_h "$1")
target_dir_h_as_t=$(home_as_tilde "$target_dir_h_as_h")
fzf_prompt="(dir=$target_dir_h_as_t)"
fzf_query=$(get_fzf_query "$1")
fzf_preview=$(cat <<'EOF'
f_hah="$(home_as_home {})"
h_abs="$(home_as_home {}| xargs realpath)"
if is_binary "$h_abs"; then
  home_as_tilde "$h_abs"
  echo
  echo "<<<BINARY FILE>>>"
  { set -x; exiftool -s -t "$h_abs" }| column -s$'\t' -t| awk '{ printf "%2d %s\n", NR, $0 }'
  echo "---"
  { set -x; bat --show-all --nonprintable-notation caret "$h_abs"}
else
  is_git_repo=$(cd $(dirname "$h_abs"); git rev-parse --is-inside-work-tree 2> /dev/null)
  if [[ "$is_git_repo" == "true" ]]; then
    git_blame_colored "$h_abs"
  else
    { set -x; bat "$f_hah" --color=always --style=numbers --line-range :100 }
  fi
fi
EOF
)
res=$(apply_fzf "$target_dir_h_as_h" "$target_dir_h_as_t" "$fzf_query" "$fzf_prompt" "$fzf_preview"|| printf "%s" "$1")
echo "$res" | awk '{ if (NF >= 2) { printf "\"%s\"", $0 } else { printf "%s", $0 } }'
