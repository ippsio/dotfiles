#!/usr/bin/env bash
if [[ -z "$1" || "$1" == "." || "$1" == "./" ]]; then
  TARGET_DIR="."
  FZF_QUERY=""
else
  TARGET_DIR=$(home_as_home "${1#./}")
  if [[ ! -e "${TARGET_DIR}" ]]; then
    echo "$1"
    exit
  fi
  FZF_QUERY=$(home_as_tilde "${1#./}")
fi

# FZFプロンプト
FZF_PROMPT_BASENAME=$(basename "$0")
FZF_PROMPT_TARGET_DIR=$(home_as_tilde "${TARGET_DIR}")
FZF_PROMPT="${FZF_PROMPT_BASENAME} (dir='${FZF_PROMPT_TARGET_DIR})') > "

# FZFプレビュー処理スクリプト
FZF_PREVIEW_SCRIPT=$(cat <<'EOF'
file_realpath="$(home_as_home {}| xargs realpath)"
if ( is_binary "${file_realpath}" ); then
  home_as_tilde "${file_realpath}"
  echo
  echo "<<<BINARY FILE>>>"
  (set -x; exiftool -t "${file_realpath}")| cat -n
  echo "---"
  (set -x; bat --show-all --nonprintable-notation caret "${file_realpath}")
else
  true_if_git_repo=$(cd $(dirname "${file_realpath}"); git rev-parse --is-inside-work-tree 2> /dev/null)
  if [[ "${true_if_git_repo}" == "true" ]]; then
    (set -x; git_blame_colored "${file_realpath}")
  else
    (set -x; bat "$(home_as_home {})" --color=always --style=numbers --line-range :100)
  fi
fi
EOF
)

RG_RESULT=$(rg \
  --files\
  --max-depth=3\
  --hidden\
  --no-ignore\
  "${TARGET_DIR}" 2>/dev/null\
  | sed 's#^./##g'\
  | home_as_tilde\
)

echo "$RG_RESULT"\
  | fzf +m\
    --query="${FZF_QUERY} "\
    --header="ctrl+'g':ripgrep, ctrl+'-':TogglePreview"\
    --prompt="${FZF_PROMPT}"\
    --info=inline\
    --bind "ctrl-_:toggle-preview" \
    --bind "ctrl-g:execute(rg_fzf_vim . ${TARGET_DIR} < /dev/tty > /dev/tty)" \
    --preview-window=right:60%:wrap\
    --preview="$FZF_PREVIEW_SCRIPT"\
  || printf "%s" "$1"

