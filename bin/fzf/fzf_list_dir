#!/usr/bin/env bash
get_list() {
  (
    echo "${2/./}.."
    echo "${2/./}."
    find -Es "$1" -type d -not -regex '.*/(\.git|\.git/).*' -maxdepth 1 2>/dev/null\
      | grep -v "^${1}$"\
      | sed 's#^(\./)##; s#$#/#g'\
      | home_as_tilde
  )
}
make_fzf_preview() {
  printf '%s\n' "d_abs=\$(echo '{}'| sed -e \"s#^~#\${HOME}#\")"
  printf '%s\n' "d_abs=\$(realpath \"\${d_abs}\")"
  printf '%s\n' "d_abs=\$(echo \"\${d_abs}/\"| sed 's#//\$#/#');"
  printf '%s\n' "echo \"\${d_abs}\";"
  printf '%s\n' "echo;"
  printf '%s\n' "ls -UlaFG --color=always \"\${d_abs}\""
}
apply_fzf() {
  get_list "$1" "$2"| fzf +m\
    --query="$3 "\
    --prompt="$4"\
    --info=inline\
    --bind 'a:ignore' --bind 'b:ignore' --bind 'c:ignore'\
    --bind 'd:ignore' --bind 'e:ignore' --bind 'f:ignore'\
    --bind 'g:ignore' --bind 'h:ignore'\
    --bind 'i:enable-search+unbind(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z)'\
    --bind 'j:Down' --bind 'k:Up'\
    --bind 'l:ignore' --bind 'm:ignore' --bind 'n:ignore'\
    --bind 'o:ignore' --bind 'p:ignore'\
    --bind 'q:abort'\
    --bind 'r:ignore' --bind 's:ignore' --bind 't:ignore'\
    --bind 'u:ignore' --bind 'v:ignore' --bind 'w:ignore'\
    --bind 'x:ignore' --bind 'y:ignore' --bind 'z:ignore'\
    --bind 'esc:enable-search+unbind(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z)'\
    --bind "ctrl-_:toggle-preview" \
    --preview-window=right:60%:wrap\
    --preview="$5"
}

dir=$(dirname "$0")
source "${dir}/func/fzf_list_functions.sh"
basename0=$(basename "$0")
target_dir_h_as_h=$(get_target_dir_h_as_h "$1")
target_dir_h_as_t=$(home_as_tilde "$target_dir_h_as_h")
fzf_prompt=$(printf "%s (dir='%s')" "$basename0" "$target_dir_h_as_t")
fzf_query=$(get_fzf_query "$1")
fzf_preview=$(make_fzf_preview)
res=$(apply_fzf "$target_dir_h_as_h" "$target_dir_h_as_t" "$fzf_query" "$fzf_prompt" "$fzf_preview"|| printf "%s" "$1")
echo "$res"
