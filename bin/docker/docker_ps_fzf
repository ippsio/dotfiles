#!/usr/bin/env bash
f="$0"
[ -L "$f" ] && f=$(readlink "$f")
bn=$(basename "$f")
fzf_prompt="$bn > "
res=$(docker ps -a --format "table {{.ID}}\t {{.Names}}\t {{.Image}}\t {{.Status}}\t {{.RunningFor}}\t {{.Command}}\t {{.Ports}}"\
  | fzf --sync --info=inline --header-lines=1 --prompt="${fzf_prompt}")
if [[ -z "$res" ]]; then
  exit 1
fi
echo "$res"| awk '{ printf "%s", $1 }'

