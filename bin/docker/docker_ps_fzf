#!/usr/bin/env bash

item() { printf "{{%s}}\t" "$1"; return 0; }
items=""
items+=$(item .ID)
items+=$(item .Names)
items+=$(item .Image)
#items+=$(item .Status)
#items+=$(item .RunningFor)
#items+=$(item .Command)
items+=$(item .Ports)

docker ps -a --format "table $items"\
  | fzf --sync --info=inline --header-lines=1 --prompt="$(basename "$0") > "\
  | awk '{ printf "%s", $1 }' || exit 1
