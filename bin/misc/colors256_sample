#!/usr/bin/env bash
print_a_color() {
  local c1=$1
  local fgbg_switch=$2
  if [[ "${fgbg_switch}" -eq 0 ]]; then
    local bg="${c1}"
  fi
  # printf "\e[38;5;%dm\e[48;5;%dmfg%3s,bg%3s\e[0m" "$bg" "$bg"
  printf "\e[48;5;%dm%5s\e[0m" "$bg" "$bg"
  return 0
}

