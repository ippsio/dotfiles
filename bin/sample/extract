#!/usr/bin/env bash
for arg in "$@"; do
  case "${arg}" in
    *.zip) (set -x; unzip "${arg}") ;;
    *.tar) (set -x; tar -xvf "${arg}") ;;
    *.tar.gz) (set -x; tar -xvf "${arg}") ;;
    *.tar.xz) (set -x; tar -xvf "${arg}") ;;
    *.tar.bz2) (set -x; pbzip2 --keep -p4 --decompress --verbose "${arg}") ;;
    * ) echo "NOT IMPREMENTED." ;;
  esac
done
