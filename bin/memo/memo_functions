#!/usr/bin/env bash
[[ -z "$1" ]] && exit 1

epoc=$(date '+%s')
dt_fmt() { LC_ALL=C date -r "$epoc" "$1"; return 0; }
category="${1:-daily}"
get_category() {
  echo "$category"
}
check_category() {
  is_category_daily && return 0
  is_category_onetime && return 0

  printf "invalid category was given '%s'" "$category"
  return 1
}
is_category_daily() {
  [[ "$(get_category)" == "daily" ]]
}
is_category_onetime() {
  [[ "$(get_category)" == "onetime" ]]
}
get_category_dir() {
  dirname "$(get_file_by_category)"
}
make_category_dir_if_absent() {
  if [[ ! -d "$(get_category_dir)" ]]; then
    mkdir -p "$(get_category_dir)"
  fi
}
get_file_by_category() {
  case $(get_category) in
    "daily")
      echo "$(get_memo_base_dir)/$(get_category)/$(dt_fmt "+%Y_%m")/$(dt_fmt "+%Y_%m%d_%a").txt"
      ;;
    "onetime")
      echo "$(get_memo_base_dir)/$(get_category)/$(dt_fmt "+%Y_%m%d")/$(dt_fmt "+%Y_%m%d_%H%M%S").txt"
      ;;
  esac
}
get_memo_base_dir() {
  echo "$HOME/memo"
}
memo_base_dir_present() {
  [[ -d "$(get_memo_base_dir)" ]]
}
memo_base_dir_absent() {
  ! memo_base_dir_present
}
make_memo_base_dir_if_absent() {
  if memo_base_dir_absent; then
    mkdir -p "$(get_memo_base_dir)"
  fi
}
git_init_unless_git_repo() {
  if ( ! memo_base_dir_present ); then
    return 1
  fi
  (
    cd "$(get_memo_base_dir)"|| return 1
    if ! is_git_repo; then
      git init
    fi
  )
}
echo_new_daily_file() {
  content="\n"
  content="${content}# $(dt_fmt "+%Y/%m/%d(%a)")\n"
  content="${content}\n"
  content="${content}---\n"
  echo -e "${content}"
}
echo_new_onetime_file() {
  printf ""
}
echo_new_file_content_by_category() {
  if is_category_daily; then
    echo_new_daily_file
  elif is_category_onetime; then
    echo_new_onetime_file
  fi
}
make_new_onetime_file() {
  touch "$(get_file_by_category)"
}
file_present() {
  if [[ -f "$(get_file_by_category)" ]]; then
    echo 1
    return 0
  else
    echo 0
    return 1
  fi
}
md5_file_or_blank() {
  if file_present>/dev/null; then
    md5sum "$(get_file_by_category)"| awk '{ print $1 }'
  fi
}
file_on_remote() {
  branch=$(git branch --show-current)
  if git cat-file -e "origin/$branch:$(get_file_by_category)" 2>/dev/null; then
    return 0
  else
    return 1
  fi
}
git_commit_with_datetime() {
  now=$(date '+%Y/%m/%d(%a) %H時%M分%S秒')
  git commit -m "$now" 1>/dev/null
  h=$(git log --pretty="%h" -1)
  files=$(git show --name-only --pretty="" HEAD| xargs echo)
  printf "%s (%s)\n" "$h" "$files"
}
remote_origin_url_present() {
  remote_origin_url=$(git config --get remote.origin.url)
  [[ "$?" == 0 && -n "$remote_origin_url" ]]
}
git_fetch() {
  if remote_origin_url_present && connected_to_internet; then
    cd "$(get_memo_base_dir)" && (
      git fetch origin
    )
  fi
}
git_merge() {
  cd "$(get_memo_base_dir)" && (
    git merge --ff
  )
}
git_merge_tree() {
  cd "$(get_memo_base_dir)" && (
    branch=$(git branch --show-current)
    merge_base=$(git merge-base HEAD "origin/$branch")
    git merge-tree "$merge_base" HEAD "origin/$branch"
  )
}
git_update() {
  md5a="$1"
  file_have_been_present="$2"
  git_fetch>/dev/null 2>&1
  merge_tree=$(git_merge_tree)
  git_merge>/dev/null 2>&1
  file_is_present=$(file_present)
  md5b=$(md5_file_or_blank)

  if [[ "$file_have_been_present" == "0" ]]; then
    if [[ "$file_is_present" == "1" ]]; then
      echo ">>> File changed on remote branch. Please reload."
    fi
  elif [[ "$file_have_been_present" == "1" ]]; then
    hunks=$(echo "$merge_tree"| grep -c "<<<<<")
    if [[ "$hunks" == "0" ]]; then
      if [[ "$md5a" != "$md5b" ]]; then
        echo ">>> ファイルが変更されました。再読込して下さい"
      fi
    else
      echo ">>> 競合があるかも。再読込して下さい"
    fi
  fi
}
git_up_to_date_notes_of_today() {
  file_md5=$(md5_file_or_blank)
  file_presence=$(file_present)
  git_update "$file_md5" "$file_presence" &
}
git_any_cached() {
  cd "$(get_memo_base_dir)" &&
    [[ -n $(git status -s| wc -l| tr -d ' ') ]]
}
is_file_by_category_changed() {
  file=$(get_file_by_category)
  cd "$(get_memo_base_dir)" &&
    [[ -n $(git status -s -- "$file") ]]
}
git_commit() {
  if git_any_cached; then
    cd "$(get_memo_base_dir)" &&
      (
        git add -A
        git_commit_with_datetime
      )
    return 0
  else
    return 1
  fi
}
get_ahead_count() {
  cd "$(get_memo_base_dir)" &&
    (
      branch=$(git branch --show-current)
      git rev-list "origin/${branch}..HEAD" --count
    )
}
git_push_note_if_connected_to_internet() {
  if ! remote_origin_url_present; then
    return 1
  fi
  if ! connected_to_internet; then
    return 1
  fi

  ahead_count=$(get_ahead_count)
  if [[ $ahead_count -ge 1 ]]; then
    cd "$(get_memo_base_dir)" &&
      (
        res=$(git push -u origin HEAD 2>&1)
        code=$?
        if [[ $code -ne 0 ]]; then
          echo "git pushできませんでした"
          printf "%s" "$res"
        fi
      )
  fi
}
is_file_absent() {
  [[ ! -f "$(get_file_by_category)" ]]
}
make_new_file_by_category_if_absent(){
  if is_file_absent; then
    echo_new_file_content_by_category> "$(get_file_by_category)"
  fi
}
md5_new_file_content_by_category() {
  echo_new_file_content_by_category| md5sum| awk '{ print $1 }'
}
md5_file_by_category() {
  md5sum "$(get_file_by_category)"| awk '{ print $1 }'
}
may_rm_file_by_category() {
  md5a=$(md5_new_file_content_by_category)
  md5b=$(md5_file_by_category)
  if [[ "$md5a" == "$md5b" ]]; then
    rm "$(get_file_by_category)"
  fi
}
open_file_with_nvim() {
  (
    cd "$(get_memo_base_dir)"|| exit
    make_new_file_by_category_if_absent
    nvim "$(get_file_by_category)"
    may_rm_file_by_category
  )
}
connected_to_internet() {
  if curl -fs --connect-timeout 1 http://clients3.google.com/generate_204 >/dev/null 2>&1; then
    # インターネットに接続されている。
    return 0
  else
    # インターネットに接続されていない。
    return 1
  fi
}

check_category || exit 1
make_memo_base_dir_if_absent
git_init_unless_git_repo
make_category_dir_if_absent
