#!/usr/bin/env bash
epoc=$(date '+%s')
today_ym=$(LC_ALL=C date -r "$epoc" '+%Y_%m')
today_ymda1=$(LC_ALL=C date -r "$epoc" '+%Y_%m%d_%a')
today_ymda2=$(LC_ALL=C date -r "$epoc" '+%Y/%m/%d(%a)')
arg_kind="${1:-memo}"
readonly KIND="${arg_kind}"
readonly BASE_DIR=~/notes
readonly NOTE_DIR="${BASE_DIR}/${KIND}/${today_ym}"
readonly TODAYS_NOTE="${BASE_DIR}/${KIND}/${today_ym}/${today_ymda1}.md"
readonly PREVIEW="(echo '# {}'; bat '{}' --color=always --style=numbers)"
readonly RG_CMD="rg --files --hidden -g '20*.{md,txt}' --sortr=path ${BASE_DIR}/${KIND}"
readonly FZF_START="${RG_CMD}| sed -E 's#^${HOME}#~#'"
readonly FZF_NVIM_CMD="/usr/bin/env bash -c 'nvim -c 5 {} < /dev/tty > /dev/tty'"

mkdir_if_base_dir_not_exists() {
  if [ ! -d "${BASE_DIR}" ]; then
    mkdir -p "${BASE_DIR}"
    cd "${BASE_DIR}"|| return 1
    git init
    cd ..
  fi
}
mkdir_if_note_dir_not_exists() {
  if [ ! -d "${NOTE_DIR}" ]; then
    mkdir -p "${NOTE_DIR}"
  fi
}
make_todays_note_if_not_exists() {
  if [ ! -f "${TODAYS_NOTE}" ]; then
    last_file=$(eval "${RG_CMD}"| head -1)
    last_content=$(tail -n +5 "${last_file}" )
    content="\n"
    content="${content}# ${KIND} ${today_ymda2}\n"
    content="${content}\n"
    content="${content}---\n"
    content="${content}${last_content}"
    echo -e "${content}">>"${TODAYS_NOTE}"
  fi
}
note_of_today() {
  echo "${TODAYS_NOTE}"
}
select_note() {
  fzf --ansi --info=inline --prompt="(${KIND})"\
      --style=minimal \
      --bind "start:reload:(${FZF_START})"\
      --bind "j:down" --bind "k:up"  --bind "q:abort"\
      --bind "enter:execute(${FZF_NVIM_CMD})"\
      --preview="${PREVIEW}" --preview-window=right,65%\
    && return 0\
    || return 1
}
git_commit_with_datetime() {
  now=$(date '+%Y/%m/%d(%a) %H時%M分%S秒')
  git commit -m "$now" 1>/dev/null
  h=$(git log --pretty="%h" -1)
  files=$(git show --name-only --pretty="" HEAD| xargs echo)
  printf "%s (%s)\n" "$h" "$files"
}
git_fetch_note() {
  cd "${BASE_DIR}" && (
    git fetch origin
  )
}
git_merge_note() {
  cd "${BASE_DIR}" && (
    git merge --ff
  )
}
git_commit_note() {
  cd "${BASE_DIR}" && (
    git add -A
    git_commit_with_datetime
  )
}
git_push_note_if_connected_to_internet() {
  if connected_to_internet; then
    cd "${BASE_DIR}" && (
      git push -u origin HEAD
    )
  fi
}
nvim_note_today() {
  (
    cd "$BASE_DIR"|| exit
    file=$(note_of_today)
    nvim "$file"
  )
}
connected_to_internet() {
  if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
    # インターネットに接続されている。
    return 0
  else
    # インターネットに接続されていない。
    return 1
  fi
}
