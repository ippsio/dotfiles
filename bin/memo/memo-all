#!/usr/bin/env bash

# 共通関数・共通変数を読み込む
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/memo_common"

f_project="$base_dir/project/project.txt"
f_todo="$base_dir/todo.txt"
f_sticky="$base_dir/sticky.txt"
f_daily="$base_dir/daily/$dt_ym/$dt_ymda.txt"

sun_s=$(date -vsun '+%s')
sat_s=$(date -vsat '+%s')
sun_ym=$(format_dt "$sun_s" "+%Y_%m")
sun=$(format_dt "$sun_s" "+%Y_%m%d_%a")
sat=$(format_dt "$sat_s" "+%Y_%m%d_%a")
f_weekly="$base_dir/weekly/$sun_ym/${sun}-${sat}.txt"

ensure_files() {
  ensure_file "$f_project" "プロジェクト進行状況"
  ensure_file "$f_weekly" "週次：${sun}-${sat}"
  dt_ymda2=$(dt_ymd_a_local)
  f_daily_detail=$(get_f_daily_detail)
  ensure_file "$f_daily" "日次: $dt_ymda2"
  ensure_file "$f_daily_detail" "日次詳細: $dt_ymda2"
  ensure_file "$f_todo" "TODO"
  ensure_file "$f_sticky" "固定メモ"
}
open_files_with_nvim() {
  (
    cd "$base_dir" || exit
    nvim "$f_project" -c "set nowrap | vsplit $f_weekly\
      | split $f_daily_detail | wincmd h | split $f_daily\
      | wincmd k | wincmd l | vsplit $f_todo | vsplit $f_sticky\
      | wincmd j"
  )
}

ensure_basedir
ensure_git_managed
ensure_files
open_files_with_nvim
git_commit
