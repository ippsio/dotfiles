#!/usr/bin/env bash

epoc=$(date '+%s')
format_dt() {
  LC_ALL=C date -r "$1" "$2"; return 0;
}
format_epoc_dt() {
  format_dt "$epoc" "$1"
}
get_basedir() {
  echo "$HOME/memo"
}
get_project_file() {
  echo "$(get_basedir)/project/project.txt"
}
get_todo_file() {
  echo "$(get_basedir)/todo.txt"
}
get_sticky_file() {
  echo "$(get_basedir)/sticky.txt"
}
get_daily_file() {
  echo "$(get_basedir)/daily/$(format_epoc_dt "+%Y_%m")/$(format_epoc_dt "+%Y_%m%d_%a").txt"
}
get_daily_detail_file() {
  echo "$(get_basedir)/daily_detail/$(format_epoc_dt "+%Y_%m")/$(format_epoc_dt "+%Y_%m%d_%a").txt"
}
get_sun_of_week() {
  date -vsun '+%s'
}
get_sat_of_week() {
  date -vsat '+%s'
}
get_weekly_file() {
  sun_s=$(get_sun_of_week)
  sat_s=$(get_sat_of_week)
  sun_ym=$(format_dt "$sun_s" "+%Y_%m")
  sun=$(format_dt "$sun_s" "+%Y_%m%d_%a")
  sat=$(format_dt "$sat_s" "+%Y_%m%d_%a")
  echo "$(get_basedir)/weekly/$sun_ym/${sun}-${sat}.txt"
}
ensure_basedir() {
  mkdir -p "$(get_basedir)"
}
ensure_dir() {
  [[ -d "$1" ]] || mkdir -p "$1"
}
ensure_git_managed() {
  (
    cd "$(get_basedir)"|| return 1
    is_git_repo || git init
  )
}
ensure_file() {
  local f="$1"
  fdir=$(dirname "$f")
  ensure_dir "$fdir"
  local content="$2"
  [[ -f "$f" ]] || echo "$content">"$f"
}
ensure_files() {
  ensure_file "$(get_project_file)" "$(get_project_content)"
  ensure_file "$(get_weekly_file)" "$(get_weekly_content)"
  ensure_file "$(get_daily_file)" "$(get_daily_content)"
  ensure_file "$(get_daily_detail_file)" "$(get_daily_detail_content)"
  ensure_file "$(get_todo_file)" "$(get_todo_content)"
  ensure_file "$(get_sticky_file)" "$(get_sticky_content)"
}
get_content() {
  echo "# $1"
  echo
  echo "---"
  echo
}
get_todo_content() {
  get_content "TODO"
}
get_sticky_content() {
  get_content "固定メモ"
}
get_project_content() {
  get_content "プロジェクト進行状況"
}
get_weekly_content() {
  sun_s=$(get_sun_of_week)
  sat_s=$(get_sat_of_week)
  sun=$(format_dt "$sun_s" "+%Y_%m%d_%a")
  sat=$(format_dt "$sat_s" "+%Y_%m%d_%a")
  get_content "週次：${sun}-${sat}"
}
get_daily_content() {
  get_content "日次: $(format_epoc_dt '+%Y/%m/%d(%a)')"
}
get_daily_detail_content() {
  get_content "日次詳細: $(format_epoc_dt '+%Y/%m/%d(%a)')"
}
git_commit() {
  (
    cd "$(get_basedir)" || return 1
    git add -A
    [[ -n $(git status -s| wc -l| tr -d ' ') ]] || return 1
    git commit -m "update" 1>/dev/null
  )
}
open_files_with_nvim() {
  (
    cd "$(get_basedir)" || exit
    project=$(get_project_file)
    daily=$(get_daily_file)
    daily_detail=$(get_daily_detail_file)
    todo=$(get_todo_file)
    sticky=$(get_sticky_file)
    weekly=$(get_weekly_file)
    nvim "$project" -c "vsplit $daily_detail | vsplit $sticky| wincmd 2h | split $weekly| split $daily| split $todo | wincmd 3k"
  )
}
ensure_basedir
ensure_git_managed
ensure_files
open_files_with_nvim
git_commit
