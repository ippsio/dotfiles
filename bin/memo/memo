#!/usr/bin/env bash

epoc=$(date '+%s')
format_dt() {
  LC_ALL=C date -r "$epoc" "$1"; return 0;
}
get_basedir() {
  echo "$HOME/memo"
}
get_project_file() {
  echo "$(get_basedir)/project/project.txt"
}
get_todo_file() {
  echo "$(get_basedir)/todo.txt"
}
get_sticky_file() {
  echo "$(get_basedir)/sticky.txt"
}
get_daily_file() {
  echo "$(get_basedir)/daily/$(format_dt "+%Y_%m")/$(format_dt "+%Y_%m%d_%a").txt"
}
get_daily_detail_file() {
  echo "$(get_basedir)/daily_detail/$(format_dt "+%Y_%m")/$(format_dt "+%Y_%m%d_%a").txt"
}
ensure_basedir() {
  mkdir -p "$(get_basedir)"
}
ensure_dir() {
  [[ -d "$1" ]] || mkdir -p "$1"
}
ensure_git_managed() {
  (
    cd "$(get_basedir)"|| return 1
    is_git_repo || git init
  )
}
ensure_file() {
  local f="$1"
  fdir=$(dirname "$f")
  ensure_dir "$fdir"
  local content="$2"
  [[ -f "$f" ]] || echo "$content">"$f"
}
ensure_files() {
  ensure_file "$(get_project_file)" "$(get_project_content)"
  ensure_file "$(get_daily_file)" "$(get_daily_content)"
  ensure_file "$(get_daily_detail_file)" "$(get_daily_detail_content)"
  ensure_file "$(get_todo_file)" "$(get_todo_content)"
  ensure_file "$(get_sticky_file)" "$(get_sticky_content)"
}
get_content() {
  echo "# $1"
  echo
  echo "---"
  echo
}
get_todo_content() {
  get_content "TODO"
}
get_sticky_content() {
  get_content "固定メモ"
}
get_project_content() {
  get_content "プロジェクト進行状況"
}
get_daily_content() {
  get_content "日次: $(format_dt '+%Y/%m/%d(%a)')"
}
get_daily_detail_content() {
  get_content "日次詳細: $(format_dt '+%Y/%m/%d(%a)')"
}
git_commit() {
  (
    cd "$(get_basedir)" || return 1
    git add -A
    [[ -n $(git status -s| wc -l| tr -d ' ') ]] || return 1
    git commit -m "update" 1>/dev/null
  )
}
open_files_with_nvim() {
  (
    cd "$(get_basedir)" || exit
    f1=$(get_project_file)
    f2=$(get_daily_file)
    f3=$(get_daily_detail_file)
    f4=$(get_todo_file)
    f5=$(get_sticky_file)
    nvim "$f1"\
      -c "split $f2"\
      -c 'wincmd 2k'\
      -c "vsplit $f4"\
      -c "vsplit $f5"\
      -c 'wincmd j'\
      -c "vsplit $f3"\
      -c 'wincmd h'
  )
}

ensure_basedir
ensure_git_managed
ensure_files
open_files_with_nvim
git_commit
