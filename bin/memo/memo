#!/usr/bin/env bash

# 共通関数・共通変数を読み込む
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/memo_common"
f_daily_detail=$(get_f_daily_detail)

# 日次詳細の「直前日分（直近の既存ファイル）」と「本日分」を nvim で開く。
open_files_with_nvim() {
  local prev
  prev=$(find_prev_daily_detail)
  (
    cd "$base_dir" || exit
    if [[ -n $prev ]]; then
      nvim "$prev" -c "set nowrap | vsplit $f_daily_detail"
    else
      nvim "$f_daily_detail" -c "set nowrap"
    fi
  )
}

ensure_basedir
ensure_git_managed
ensure_file "$f_daily_detail" "日次詳細: $(dt_ymd_a_local)"
open_files_with_nvim
git_commit
