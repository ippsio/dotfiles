#!/usr/bin/env bash
# memo 系コマンドの共通関数・共通変数。各コマンドから source して使う。

base_dir="$HOME/memo"

epoc=$(date '+%s')
format_epoc_dt() {
  LC_ALL=C date -r "$epoc" "$1"; return 0;
}
dt_ymda=$(format_epoc_dt "+%Y_%m%d_%a")
dt_ymda2=$(format_epoc_dt "+%Y/%m/%d(%a)")
dt_ym=${dt_ymda:0:7}

f_daily_detail="$base_dir/daily_detail/$dt_ym/$dt_ymda.txt"

format_dt() {
  LC_ALL=C date -r "$1" "$2"; return 0;
}

ensure_basedir() {
  [[ -d $base_dir ]] || mkdir -p "$base_dir"
}
find_up() {
  local dir
  dir=$PWD
  while [[ $dir != "/" ]]; do
    [[ -e $dir/$1 ]] && return 0
    dir=${dir%/*}
    dir=${dir:-/}
  done
  return 1
}
ensure_git_managed() {
  (
    cd "$base_dir" || return 1
    find_up .git || git init
  )
}
ensure_file() {
  local file="$1"
  local content="$2"

  [[ -f "$file" ]] && return 0
  local fdir="${file%/*}"
  [[ -d "$fdir" ]] || mkdir -p "$fdir"
  printf "\n# %s\n---\n" "$content">"$file"
  echo "">>"$file"
}
git_commit() {
  (
    cd "$base_dir" || return 1
    git add -A
    [[ -n $(git status -s| wc -l| tr -d ' ') ]] || return 1
    git commit -m "update" 1>/dev/null
  )
}
# 本日より前で、実際に存在する最新の日次詳細ファイルパスを返す。
find_prev_daily_detail() {
  local dd_dir="$base_dir/daily_detail"
  local f b prev=""
  while IFS= read -r f; do
    b=${f##*/}; b=${b%.txt}   # basename 相当（fork せずパラメータ展開で処理）
    [[ $b < $dt_ymda ]] && prev="$f"
  done < <(LC_ALL=C find "$dd_dir" -type f -name '*.txt' 2>/dev/null | LC_ALL=C sort)
  [[ -n $prev ]] && printf '%s\n' "$prev"
}
