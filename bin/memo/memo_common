#!/usr/bin/env bash
# memo 系コマンドの共通関数・共通変数。各コマンドから source して使う。

base_dir="$HOME/memo"
printf -v epoc '%(%s)T' -1

dt_ymda=$(LC_ALL=C printf "%(%Y_%m%d_%a)T\n" "$epoc")
dt_ym=${dt_ymda:0:7}
dt_ymd_a_local() { LC_ALL=C printf "%(%Y/%m/%d(%a))T\n" "$epoc"; return 0; }
get_f_daily_detail() { echo "$base_dir/daily_detail/$dt_ym/$dt_ymda.txt"; return 0; }
format_dt() { LC_ALL=C date -r "$1" "$2"; return 0; }

ensure_basedir() {
  [[ -d $base_dir ]] || mkdir -p "$base_dir"
}

ensure_git_managed() {
  if [[ ! -d "$base_dir/.git" ]]; then
    (cd "$base_dir" && git init)
  fi
}

ensure_file() {
  local file="$1"
  local content="$2"

  [[ -f "$file" ]] && return 0
  local fdir="${file%/*}"
  [[ -d "$fdir" ]] || mkdir -p "$fdir"
  printf "\n# %s\n---\n" "$content" >"$file"
  echo "" >>"$file"
}

git_commit() {
  (
    cd "$base_dir" || return 1
    git add -A
    if ! git diff --cached --quiet || ! git diff --quiet; then
      git commit -m "update" 1>/dev/null
    fi
  )
}

find_prev_daily_detail() {
  local dd_dir="$base_dir/daily_detail"
  local files=("$dd_dir"/*/*.txt)
  local i b f
  for ((i=${#files[@]}-1; i>=0; i--)); do
    f="${files[i]}"
    [[ -e "$f" ]] || continue
    b=${f##*/}; b=${b%.txt}
    if [[ $b < $dt_ymda ]]; then
      printf '%s\n' "$f"
      return 0
    fi
  done
}
