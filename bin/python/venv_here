#!/usr/bin/env bash

do_pyenv_local() {
  pyenv versions
  python_version=$(pyenv versions| grep -E '^\*'| awk '{ print $2 }')
  if [[ -z "$python_version" ]]; then
    echo "decide python version first."
    exit 1
  fi
  (set -x; pyenv local "$python_version")
}
tee_envrc() {
  (
    echo "# ================================================================"
    echo "[[ -e .venv/bin/activate ]] || python3 -m venv .venv"
    echo "source .venv/bin/activate"
    echo "# ================================================================"
  )> .envrc
}
python_venv() {
  (set -x; python3 -m venv .venv)
}

if [[ ! -e .python-version ]]; then
  do_pyenv_local
fi

if [[ ! -d .venv ]]; then
  python_venv
fi

if [[ ! -f .envrc ]]; then
  tee_envrc
fi

(set -x; direnv allow)
(set -x; which python)
