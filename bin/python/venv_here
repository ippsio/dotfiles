#!/bin/bash
if [[ ! -e .python-version ]]; then
  pyenv versions
  python_version=$(pyenv versions| grep -E '^\*'| awk '{ print $2 }')
  if [[ -z "$python_version" ]]; then
    echo "decide python version first."
    exit 1
  fi
  (set -x; pyenv local "$python_version")
fi

_envrc_content=$(cat << EOF
# ================================================================
[[ -e .venv/bin/activate ]] || python3 -m venv .venv
source .venv/bin/activate
# ================================================================
EOF
)
if [[ -d .venv ]]; then
  echo ".venv exists."
else
  (set -x; python3 -m venv .venv)
fi

if [[ -f .envrc ]]; then
  echo ".envrc exists."
else
  echo "$_envrc_content"| tee .envrc
fi

(set -x; direnv allow)
(set -x; which python)
