#!/usr/bin/env bash
rg_wrap "$@" \
  | fzf \
    -m \
    --info=inline \
    --ansi \
    --delimiter='	' \
    --tabstop=2 \
    --prompt="($(basename $0))" \
    --header="${FZF_HEADER}" \
    --bind "enter:execute(nvim {2} +{3} < /dev/tty > /dev/tty)" \
    --bind='ctrl-/:toggle-preview' \
    --bind='ctrl-_:toggle-preview' \
    --preview 'bat --color=always {2} --highlight-line {3}' \
    --preview-window '+{3}+3/3,~7'
