#!/usr/bin/env bash
do_fzf() {
  fzf \
    -m \
    --no-sort \
    --info=inline \
    --ansi \
    --delimiter='	' \
    --tabstop=2 \
    --prompt="($(basename "$0"))" \
    --header="${FZF_HEADER}" \
    --bind "enter:execute(nvim {1} +{2} < /dev/tty > /dev/tty)" \
    --bind='ctrl-/:toggle-preview' \
    --bind='ctrl-_:toggle-preview' \
    --preview 'bat --color=always {1} --highlight-line {2}' \
    --preview-window '+{2}+3/3,~7'
}
rg "$@"| do_fzf
