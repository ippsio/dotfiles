#!/usr/bin/env bash
results=$(rg \
  --fixed-strings \
  --field-match-separator '\t' \
  --field-context-separator '\t' \
  --no-context-separator \
  --color=always \
  --no-ignore \
  --hidden \
  --vimgrep \
  --no-column \
  --glob !.git/ \
  --glob !.DS_Store \
  "$@")
exit_cd=$?
cnt=$(echo "${results}"| wc -l| tr -d ' ')
if [[ "${exit_cd}" != 0 ]]; then
  echo "Not found"
else
  echo "${results}"| awk -v cnt="$cnt" '{ printf "(%3d/%d:ripgrep)	%s\n", NR, cnt, $0 }'
fi
exit ${exit_cd}

