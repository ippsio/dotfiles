bind diff h      view-close
bind diff l      view-blame
# 経験・実験より知った事ですが、Shift+Upは'A'、Shift+Downは'B'として扱われるようです。
# <Shift-Up>、<ShiftUp>、<S-Up>等としても、Shift+Up時のキーバインド設定を行ないたいという意志がtigに伝わりません。
# Shift+Upで前のファイル
bind diff A previous
# Shift+Downで次のファイル
bind diff B next
bind diff    ]      :/^@@
bind diff    [      :?^@@
bind diff    g      :/^---$ # goto file list
bind diff [ :toggle diff-context -1		   # Decrease context (-U arg)
bind diff ] :toggle diff-context +1		   # Increase context

bind diff o >tig_git_difftool_handler %(file)	%(commit)	%(revargs)
bind diff <Tab> >tig_git_difftool_handler %(file)	%(commit)	%(revargs)

bind diff E >bash -c "~/dotfiles/bin/tig/tig_edit_with_vim_on_tmux %(file) %(lineno)"
#revargs=%(revargs),fileargs=%(fileargs),cmdlineargs=%(cmdlineargs),
bind diff    ;      @hub browse -- commit/%(commit)
