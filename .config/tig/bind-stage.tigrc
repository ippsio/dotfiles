bind stage l      view-blame
bind stage <Left> view-close
bind stage o      view-close
# 経験・実験より知った事ですが、Shift+Upは'A'、Shift+Downは'B'として扱われるようです。
# <Shift-Up>、<ShiftUp>、<S-Up>等としても、Shift+Up時のキーバインド設定を行ないたいという意志がtigに伝わりません。
# Shift+Upで前のファイル
bind stage A previous
# Shift+Downで次のファイル
bind stage B next
bind stage C      !git commit
bind stage - >bash -c "~/dotfiles/bin/tig/tig_git_checkout_-- %(file)"
bind stage h view-close-no-quit
bind stage E >bash -c "~/dotfiles/bin/tig/tig_edit_with_vim_on_tmux %(file) %(lineno)"
bind stage <C-g> !bash -c "$HOME/dotfiles/bin/tig/tig_copy_filename %(file)"
