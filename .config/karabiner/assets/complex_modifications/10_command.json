{
  "title": "[10:command] behaviors",
  "rules": [
    {
      "description": "11:command + hjkl/ ae/ d",
      "manipulators": [
        {"type": "basic", "from": {"key_code": "h", "modifiers": {"mandatory": ["command"], "optional": ["any"]}}, "to": [{"key_code": "left_arrow"}]},
        {"type": "basic", "from": {"key_code": "j", "modifiers": {"mandatory": ["command"], "optional": ["any"]}}, "to": [{"key_code": "down_arrow"}]},
        {"type": "basic", "from": {"key_code": "k", "modifiers": {"mandatory": ["command"], "optional": ["any"]}}, "to": [{"key_code": "up_arrow"}]},
        {"type": "basic", "from": {"key_code": "l", "modifiers": {"mandatory": ["command"], "optional": ["any"]}}, "to": [{"key_code": "right_arrow"}]},
        {"type": "basic", "from": {"key_code": "a", "modifiers": {"mandatory": ["left_command"], "optional": ["any"]}}, "to": [{"key_code": "a", "modifiers":["control"]}]},
        {"type": "basic", "from": {"key_code": "a", "modifiers": {"mandatory": ["right_command"], "optional": ["any"]}}, "to": [{"key_code": "a", "modifiers":["control"]}]},
        {"type": "basic", "from": {"key_code": "e", "modifiers": {"mandatory": ["left_command"], "optional": ["any"]}}, "to": [{"key_code": "e", "modifiers":["control"]}]},
        {"type": "basic", "from": {"key_code": "e", "modifiers": {"mandatory": ["right_command"], "optional": ["any"]}}, "to": [{"key_code": "e", "modifiers":["control"]}]},
        {"type": "basic", "from": {"key_code": "d", "modifiers": {"mandatory": ["left_command"], "optional": ["any"]}}, "to": [{"key_code": "d", "modifiers":["control"]}]}
      ]
    },
    {
      "description": "12: command(left) + space toggle eisuu/kana",
      "manipulators": [
        {
          "type": "basic",
          "from": {"key_code": "space", "modifiers": {"mandatory": ["command"], "optional": ["any"]}},
          "to": [{ "key_code": "left_command", "lazy": true }],
          "to_if_held_down": [{ "key_code": "left_command" }],
          "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "ja" }] }],
          "to_if_alone": [{ "key_code": "japanese_eisuu" }]
        },
        {
          "type": "basic",
          "from": {"key_code": "space", "modifiers": {"mandatory": ["command"], "optional": ["any"]}},
          "to": [{ "key_code": "left_command", "lazy": true }],
          "to_if_held_down": [{ "key_code": "left_command" }],
          "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "en" }] }],
          "to_if_alone": [{ "key_code": "japanese_kana" }]
        }
      ]
    },
    {
      "description": "13: command(right) to_if_alone toggle eisuu/kana",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "right_command" },
          "to": [{ "key_code": "right_command", "lazy": true }],
          "to_if_held_down": [{ "key_code": "right_command" }],
          "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "ja" }] }],
          "to_if_alone": [{ "key_code": "japanese_eisuu" }]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_command" },
          "to": [{ "key_code": "right_command", "lazy": true }],
          "to_if_held_down": [{ "key_code": "right_command" }],
          "conditions": [{ "type": "input_source_if", "input_sources": [{ "language": "en" }] }],
          "to_if_alone": [{ "key_code": "japanese_kana" }]
        }
      ]
    },
    {
      "description": "14: make command(right) non-moidfier key",
      "manipulators": [
        {"type": "basic", "from": {"key_code": "a", "modifiers": {"mandatory": ["right_command"], "optional": ["any"]}}, "to": []},
        {"type": "basic", "from": {"key_code": "b", "modifiers": {"mandatory": ["right_command"], "optional": ["any"]}}, "to": []},
        {"type": "basic", "from": {"key_code": "c", "modifiers": {"mandatory": ["right_command"], "optional": ["any"]}}, "to": []},
